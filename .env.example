# App runtime
VILACIRCULA_ENV=development
PORT=8000
HOST=0.0.0.0
VILACIRCULA_DATABASE=data/vilacircula.sqlite3

# CORS: separa orígenes por comas. En producción no uses "*" ni secretos en el frontend.
VILACIRCULA_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# Secretos y credenciales del servidor
VILACIRCULA_ADMIN_KEY=change-me-with-a-long-random-secret
VILACIRCULA_MERCHANT_KEY=
VILACIRCULA_INITIAL_CASHIER_PASSWORD=change-me-with-a-strong-unique-password
VILACIRCULA_ALLOW_SELF_REDEEM=0

# Emails verificados con acceso al panel municipal, separados por comas
VILACIRCULA_ADMIN_EMAILS=municipal@example.com

# Códigos exclusivos por centro (JSON); guarda los códigos reales solo en el servidor
VILACIRCULA_SCHOOL_CODES={"Goar":"CAMBIAR-CODIGO-GOAR","Sales":"CAMBIAR-CODIGO-SALES"}

# Producción real: usa HTTPS y deja esta lista explícita del dominio real
# VILACIRCULA_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
